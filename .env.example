# WhatsApp Configuration
# Format: country code + number (e.g., 254712345678 for Kenya)
VITE_WHATSAPP_NUMBER=254708345963

# Formspree is REMOVED (owner order, 02b). Inquiries go to the first-party
# endpoint below; the server sends Brevo mail. See docs/integrations/BREVO.md.
VITE_INQUIRY_ENDPOINT=/api/inquiries

# --- Server-side only (never VITE_*, never committed) ---
# BREVO_API_KEY=xkeysib-...
# BREVO_SENDER_EMAIL=hello@verified-domain
# BREVO_SENDER_NAME=404HubSpot
# INQUIRY_TO_EMAIL=team-inbox@example.com
# BREVO_TEMPLATE_INTERNAL=
# BREVO_TEMPLATE_AUTOREPLY=

# Google Meet Link (for scheduled consultations)
VITE_GOOGLE_MEET_URL=https://meet.google.com/your-meeting-link

# Canonical site URL (SEO canonical/OG/sitemap). PROVISIONAL until the
# primary domain is confirmed — then replace everywhere incl.
# public/sitemap.xml + public/robots.txt.
VITE_SITE_URL=https://404hubspot.co.ke

# Clerk Auth (paste from Clerk Dashboard or `npx clerk init`; demo shell runs without it)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_paste_here
